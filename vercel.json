{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://wisdom-temple.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://wisdom-temple.onrender.com/uploads/:path*" },
    { "source": "/healthz", "destination": "https://wisdom-temple.onrender.com/healthz" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/:path*", "destination": "/admin/index.html" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
